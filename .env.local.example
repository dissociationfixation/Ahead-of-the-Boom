# Ahead of the Boom - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials
# DO NOT commit .env.local to version control

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_AUDIENCE_ID=your_resend_audience_id_here

# OpenAI API
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Reddit API (Optional - for future Reddit scraping)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=TrendNewsletterBot/1.0

# Next.js / Manus Platform (Auto-populated by platform)
VITE_APP_TITLE=Ahead of the Boom
VITE_APP_ID=your_app_id
VITE_OAUTH_PORTAL_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=your_frontend_key
VITE_ANALYTICS_ENDPOINT=https://analytics.manus.im
VITE_ANALYTICS_WEBSITE_ID=your_website_id

# Database (Auto-populated by platform)
DATABASE_URL=mysql://user:password@host/database

# JWT Secret (Auto-populated by platform)
JWT_SECRET=your_jwt_secret_here

# OAuth Server (Auto-populated by platform)
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=your_owner_open_id
OWNER_NAME=Your Name

# Built-in Forge API (Auto-populated by platform)
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=your_built_in_api_key

# Node Environment
NODE_ENV=development
